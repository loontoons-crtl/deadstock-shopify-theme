<div class="container" style="padding: 2.5rem 1.25rem;">
  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 2.5rem; align-items: start;">
    
    <!-- Gallery -->
    <div style="background: var(--color-sand); border-radius: 8px; overflow: hidden; border: 1px solid var(--color-line);">
      {% if product.featured_media %}
        <img
          src="{{ product.featured_media | image_url: width: 900 }}"
          alt="{{ product.title | escape }}"
          style="width: 100%; height: auto; display: block;"
        >
      {% else %}
        <div style="height: 380px; display: flex; align-items: center; justify-content: center; color: var(--color-muted);">
          No product images
        </div>
      {% endif %}
    </div>

    <!-- Product Details -->
    <div>
      <div style="display: flex; gap: 0.5rem; flex-wrap: wrap; margin-bottom: 0.75rem;">
        {% for tag in product.tags %}
          <span style="background: var(--color-sand); border: 1px solid var(--color-line); font-size: 0.75rem; font-weight: 600; padding: 0.2rem 0.5rem; border-radius: 4px; color: var(--color-forest);">
            {{ tag }}
          </span>
        {% endfor %}
      </div>

      <h1 style="font-family: var(--font-serif); font-size: 2.25rem; line-height: 1.15; margin-bottom: 1rem; color: var(--color-ink);">
        {{ product.title }}
      </h1>

      <div style="display: flex; align-items: baseline; gap: 0.85rem; margin-bottom: 1.5rem; padding-bottom: 1rem; border-bottom: 1px solid var(--color-line);">
        <span style="font-size: 1.85rem; font-weight: 700; color: var(--color-forest);">
          {{ product.price | money }}
        </span>
        {% if product.compare_at_price > product.price %}
          <span style="font-size: 1.1rem; color: var(--color-muted); text-decoration: line-through;">
            MRP {{ product.compare_at_price | money }}
          </span>
        {% endif %}
      </div>

      <!-- Seller Contact Model -->
      <div class="seller-box">
        <div class="seller-box-title">Seller &amp; Pickup Details</div>
        <div style="font-size: 0.9rem; color: var(--color-ink); line-height: 1.5;">
          <p><strong>Vendor:</strong> {{ product.vendor | default: 'Verified Dealer' }}</p>
          {% if product.metafields.deadstock.locality %}
            <p><strong>Location:</strong> {{ product.metafields.deadstock.locality }}, Bengaluru</p>
          {% endif %}
        </div>
      </div>

      <!-- Description -->
      <div style="font-size: 0.925rem; line-height: 1.6; color: var(--color-ink); margin-bottom: 2rem;">
        {{ product.description }}
      </div>

      {% form 'product', product %}
        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
        <button
          type="submit"
          class="btn-primary"
          style="width: 100%; justify-content: center; padding: 1rem; font-size: 1rem; cursor: pointer; border: none; background: var(--color-forest); color: #fff;"
        >
          Add to Cart &bull; {{ product.price | money }}
        </button>
      {% endform %}
    </div>

  </div>
</div>

{% schema %}
{
  "name": "Product Page",
  "settings": []
}
{% endschema %}
