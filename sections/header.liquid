<header class="site-header">
  <div class="container header-inner">
    <a href="{{ routes.root_url }}" class="brand-logo">
      Deadstock
      <span class="brand-badge">Bengaluru</span>
    </a>

    <form action="{{ routes.search_url }}" method="get" role="search" class="search-form">
      {% render 'icon-search' %}
      <input
        type="search"
        name="q"
        value="{{ search.terms | escape }}"
        placeholder="Search surplus tiles, veneers, bathroom fixtures..."
        aria-label="Search"
      >
    </form>

    <nav class="nav-links">
      <a href="{{ routes.all_products_collection_url }}">Browse Catalog</a>
      <a href="{{ routes.collections_url }}">Categories</a>
      <a href="{{ routes.cart_url }}" class="cart-link">
        Cart {% if cart.item_count > 0 %}({{ cart.item_count }}){% endif %}
      </a>
    </nav>
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "settings": []
}
{% endschema %}
